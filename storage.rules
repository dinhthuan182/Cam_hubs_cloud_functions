rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function cameraDevice(cameraDeviceId) {
      return firestore.get(/databases/(default)/documents/devices/$(cameraDeviceId)).data;
    }

    function canViewCamera(cameraDeviceId) {
      let device = cameraDevice(cameraDeviceId);
      return device.ownerUserId == request.auth.uid ||
        request.auth.uid in device.get('editorUserIds', []);
    }

    function isPremiumReader() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.premium == true;
    }

    function isThumbnail(file) {
      return file.matches('.+_thumb[.]jpg');
    }

    function isClip(file) {
      return file.matches('.+[.]mp4');
    }

    // ---------- /clips/{cameraDeviceId}/{file} (007 → 019/US5) ----------
    match /clips/{cameraDeviceId}/{file} {
      allow read: if request.auth != null &&
        canViewCamera(cameraDeviceId) &&
        (isThumbnail(file) || isPremiumReader());
      allow create, update: if request.auth != null &&
        cameraDevice(cameraDeviceId).ownerUserId == request.auth.uid && (
          (isThumbnail(file) &&
            request.resource.contentType == 'image/jpeg' &&
            request.resource.size < 5 * 1024 * 1024) ||
          (isClip(file) &&
            request.resource.contentType == 'video/mp4' &&
            request.resource.size < 100 * 1024 * 1024)
        );
      allow delete: if false; // lifecycle rule only
    }
  }
}
